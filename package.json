    "serve": "^14.2.1",
    "stylis": "^4.3.2",
    "stylis-plugin-rtl": "^2.1.1",
    "survey-analytics": "latest",
    "survey-core": "latest",
    "survey-creator-core": "latest",
    "survey-creator-react": "latest",
    "survey-react-ui": "latest",
    "swiper": "^11.0.4"
