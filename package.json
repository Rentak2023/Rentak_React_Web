    "@mantine/hooks": "^6.0.16",
    "@mantine/modals": "^6.0.16",
    "@mantine/notifications": "^6.0.16",
    "@mongez/cache": "^1.2.1",
    "@mongez/config": "^1.0.26",
    "@mongez/dom": "^1.1.2",
    "@mongez/events": "^2.1.0",
    "@mongez/http": "^2.2.4",
    "@mongez/localization": "^2.2.3",
    "@mongez/moonlight": "^1.1.43",
    "@mongez/react": "^3.0.6",
    "@mongez/react-atom": "^3.1.3",
    "@mongez/react-components": "^1.0.8",
    "@mongez/react-form": "^2.1.3",
    "@mongez/react-helmet": "^1.0.9",
    "@mongez/react-hooks": "^1.3.3",
    "@mongez/react-localization": "^1.0.5",
    "@mongez/react-router": "^2.1.23",
    "@mongez/react-utils": "^1.3.12",
    "@mongez/reinforcements": "^2.3.7",
    "@mongez/supportive-is": "^1.0.12",
    "@mongez/user": "^1.0.12",
    "@mongez/validator": "^1.0.18",
    "@reduxjs/toolkit": "^2.2.1",
    "@tabler/icons-react": "^2.24.0",
    "connected-react-router": "6.9.3",
    "history": "5.3.0",
    "rc-slider": "^9.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
